# Single source of truth for what gets built. Edit these, push to main, and
# CI rebuilds and republishes. Everything here is content-addressed or a
# plain version string.
UPSTREAM_REPO=yu-i-i/overleaf-cep
# Full commit SHA, not a tag: a moved tag cannot change what gets built.
# This is v6.3.0-ext-v5.1 plus the one-line sign-up page fix that followed it.
UPSTREAM_SHA=f1b9809f358c0ee2de93d4dd9b429c0ba5af50b8
# Upstream release this SHA belongs to (used in image tags).
VERSION=6.3.0-ext-v5.1
# Bump when rebuilding the same upstream SHA (new TeX Live, base image
# refresh, Dockerfile change). Tags look like <VERSION>-r<REVISION>.
REVISION=1
# TeX Live mirror for the scheme-full layer (rolling "current" repository).
TEXLIVE_MIRROR=https://mirror.ox.ac.uk/sites/ctan.org/systems/texlive/tlnet
